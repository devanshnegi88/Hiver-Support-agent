# Copy this file to `.env` and fill in keys. `.env` is gitignored.
# Fallback order: Gemini (primary) → Ollama → keywords.

# --- Gemini (primary) — one key only, no rotation ---
GOOGLE_API_KEY=
# GEMINI_API_KEY=
GEN_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash

# --- Ollama (first fallback if Gemini fails) ---
# Leave LLM_PROVIDER empty for auto: Gemini → Ollama → keywords
# LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=2048


